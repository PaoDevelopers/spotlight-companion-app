[Unit]
Description=Spotlight Month web app
Documentation=https://github.com/PaoDevelopers/spotlight-companion-app
After=network-online.target
Wants=network-online.target

[Service]
User=spotlight
Group=spotlight
ExecStart=/opt/spotlight/spotlight -config /etc/spotlight/spotlight.conf serve
WorkingDirectory=/var/lib/spotlight
StateDirectory=spotlight
Restart=on-failure
RestartSec=3
# A graceful stop finishes in-flight requests; give it time before systemd kills it.
TimeoutStopSec=20

# The service only needs to listen, read its settings, and write its own data directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
# Uncomment ONLY if LISTEN is a port below 1024 (for example :443 with TLS_CERT/TLS_KEY):
# AmbientCapabilities=CAP_NET_BIND_SERVICE
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
