DATABASE_URL=postgres://user:pass@localhost:5432/events
CHECKIN_SECRET=change-me-long-random-string
AUTH_MODE=roster            # roster = email + printed code | entra = Microsoft sign-in only
# OIDC_TENANT_ID=           # from the school's app registration (not secret; no client secret needed)
# OIDC_CLIENT_ID=
# APP_URL=https://your-stable-domain
CRON_SECRET=change-me
ADMIN_EMAILS=you@school.edu   # first admin(s); login code printed to server log on first start
# SKIP_RUNTIME_MIGRATE=1   # set on Vercel if you migrate during the build only
# SEED_DEMO=1            # one-off: seed FAKE demo data during the build and print login codes in the build log
