{
  "name": "events-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/migrate.mts && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "test:e2e": "playwright test --timeout 180000",
    "test:e2e:prod": "playwright test -c playwright.prod.config.ts",
    "seed": "tsx scripts/seed.mts",
    "test:e2e:sso": "playwright test -c playwright.sso.config.ts --timeout 120000",
    "test:e2e:go": "playwright test -c playwright.go.config.ts --timeout 120000",
    "test:e2e:go-sso": "playwright test -c playwright.go-sso.config.ts --timeout 120000"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.13",
    "jsqr": "^1.4.0",
    "next": "^16.4.2",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
