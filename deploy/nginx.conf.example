# nginx in front of Spotlight, for when something else (CCA, an existing proxy) already uses port 443 on this machine,
# or you simply prefer a standard web server in front. Debian: sudo apt install nginx
# Save as /etc/nginx/sites-available/spotlight, then:
#   sudo ln -s /etc/nginx/sites-available/spotlight /etc/nginx/sites-enabled/spotlight
#   sudo nginx -t && sudo systemctl reload nginx
# Spotlight itself keeps LISTEN=127.0.0.1:8080 and PUBLIC_URL=https://spotlight.ykpaoschool.cn
#
# nginx ALREADY serving something else on 443 (such as CCA)? Then this is simply one more "server" block: nginx picks the right site
# by the name in the address, so Spotlight needs no second IP address and no other port. Point ssl_certificate at the same files that site
# uses (see them with: sudo nginx -T | grep -E "ssl_certificate"), run `sudo nginx -t` before reloading, and keep a copy of /etc/nginx.

server {
    listen 80;
    server_name spotlight.ykpaoschool.cn;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name spotlight.ykpaoschool.cn;

    # The school's certificate for this name (for example the wildcard CCA uses). Keep the key readable by root/nginx only.
    ssl_certificate     /etc/ssl/ykpaoschool/fullchain.pem;
    ssl_certificate_key /etc/ssl/ykpaoschool/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # IMPORTANT: nginx allows only 1 MB by default. Teachers upload pictures (up to 6 MB) and the student list (up to 5 MB).
    client_max_body_size 8m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;               # keep the original address: the app checks that requests come from its own site
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
    }
}
